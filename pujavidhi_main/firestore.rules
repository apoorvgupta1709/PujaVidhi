rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // PujaVidhi Pure Devotional Suite Collections
    match /media_tracks/{trackId} {
      allow read, write: if true;
    }
    match /festivals_and_vidhis/{vidhiId} {
      allow read, write: if true;
    }
    match /daily_suvichar/{suvicharId} {
      allow read, write: if true;
    }
    match /pujavidhi_config/{configId} {
      allow read, write: if true;
    }
    match /panchang_records/{recordId} {
      allow read, write: if true;
    }
    match /vrat_calendar/{vratId} {
      allow read, write: if true;
    }
    match /gita_chapters/{chapterId} {
      allow read, write: if true;
    }
    match /gita_shlokas/{shlokaId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
